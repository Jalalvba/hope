MONGODB_DB=hope
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Gemini cost tracking ───────────────────────────────────────────────────
# MAD per 1 USD, used to display call costs in dirhams. Defaults to 9.4.
USD_TO_MAD_RATE=9.4
# Prepaid credit loaded on the Gemini API key, in USD. Paid-tier call costs are
# subtracted from this to show the remaining balance. Defaults to 0.
GEMINI_PREPAID_USD_BALANCE=0
